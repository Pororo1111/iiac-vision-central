# python3 scripts/init-env.py 로 로컬용 무작위 자격 증명을 생성하세요.
POSTGRES_DB=central
POSTGRES_USER=central
POSTGRES_PASSWORD=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
IOT_DEVICE_ID=iot-001
IOT_DEVICE_TOKEN=
CENTRAL_PORT=8200
# 로컬 HTTP에서만 false. HTTPS 배포에서는 true.
COOKIE_SECURE=false
AI_WORKER_TOKEN=
# 사설망(Tailscale) 접속 설정. 비우면 로컬(127.0.0.1)에서만 접속한다.
# 관리자 화면 HTTPS 주소. 예: https://<중앙-MagicDNS-이름>:9443
PUBLIC_ORIGIN=
# 브라우저가 WHEP/WebRTC 연결에 사용할 HTTPS 주소. 예: https://<중앙-MagicDNS-이름>:9444
MEDIA_PUBLIC_URL=
# IoT RTMP 송출·WebRTC ICE에 쓰는 중앙의 Tailscale IP.
MEDIA_HOST=

# 자동 학습 진행 주기 트리거(기본 꺼짐). 켜면 새 LABELED 이미지가 기준 수 이상일 때 자동 실행을 만든다.
# 비우면 후보 등록까지만 진행한다.
# Roboflow Universe 데이터셋 불러오기(AI 워커 전용). 실제 키는 .env에만 둔다.
ROBOFLOW_API_KEY=
